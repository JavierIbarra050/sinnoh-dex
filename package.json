{
  "name": "sinnoh-dex",
  "private": true,
  "version": "0.0.0",
  "description": "Sinnoh Pokédex Desktop App",
  "author": "Javier <javier@example.com>",
  "homepage": "https://github.com/JavierIbarra050",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "electron:build": "vite build && electron-builder",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-draggable": "^4.7.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.75.0",
    "vite": "5.4.1",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.javieribarra050.sinnohdex",
    "productName": "Sinnoh Dex",
    "directories": {
      "output": "dist-electron-build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
